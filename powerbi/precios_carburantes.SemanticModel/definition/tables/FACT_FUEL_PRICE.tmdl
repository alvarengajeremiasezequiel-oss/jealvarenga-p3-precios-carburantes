table FACT_FUEL_PRICE
	lineageTag: c37bbc8f-b851-4b08-a67b-ca10e7852436

	measure 'Precio actual' =
			
			VAR LatestTS = MAX(FACT_FUEL_PRICE[INGESTION_TS])
			RETURN
			    CALCULATE(
			        AVERAGE(FACT_FUEL_PRICE[PRICE]),
			        FACT_FUEL_PRICE[INGESTION_TS] = LatestTS
			    )
		lineageTag: 1f5c08f3-616a-4354-be4f-97e45196e2eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variacion las ultimas 24h' = ```
			
			    VAR LatestTS = MAX(FACT_FUEL_PRICE[INGESTION_TS])
			
			    VAR CurrentAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] = LatestTS)
			    
			    VAR PreviousAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] >= LatestTS - 1
			                && FACT_FUEL_PRICE[INGESTION_TS] < LatestTS)
			    
			    RETURN CurrentAvg - PreviousAvg
			```
		lineageTag: f4b3eaaa-5b0a-4005-9f01-c7c79cf3df82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variacion la ultima semana' = ```
			
			    VAR LatestTS = MAX(FACT_FUEL_PRICE[INGESTION_TS])
			
			    VAR CurrentAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] = LatestTS)
			    
			    VAR PreviousAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] >= LatestTS - 7
			                && FACT_FUEL_PRICE[INGESTION_TS] < LatestTS)
			    
			    RETURN CurrentAvg - PreviousAvg
			```
		lineageTag: 70fc4838-6473-4a80-b5a8-87f89f865f81

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variacion relativa las ultimas 24h' = ```
			
			    VAR LatestTS = MAX(FACT_FUEL_PRICE[INGESTION_TS])
			
			    VAR CurrentAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] = LatestTS)
			    
			    VAR PreviousAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] >= LatestTS - 1
			                && FACT_FUEL_PRICE[INGESTION_TS] < LatestTS)
			    
			    RETURN (CurrentAvg - PreviousAvg)/PreviousAvg
			```
		lineageTag: 85ef0dbb-66df-4bbc-afbf-6ed64db312dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variacion relativa la ultima semana' = ```
			
			    VAR LatestTS = MAX(FACT_FUEL_PRICE[INGESTION_TS])
			
			    VAR CurrentAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] = LatestTS)
			    
			    VAR PreviousAvg =
			        CALCULATE(AVERAGE(FACT_FUEL_PRICE[PRICE]),
			            FACT_FUEL_PRICE[INGESTION_TS] >= LatestTS - 7
			                && FACT_FUEL_PRICE[INGESTION_TS] < LatestTS)
			    
			    RETURN (CurrentAvg - PreviousAvg) / PreviousAvg
			```
		lineageTag: 1048c422-75ef-4177-9de9-e1d778a5f8a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

